rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (request.auth.uid == userId || hasRole('admin'));
      allow delete: if hasRole('admin');
    }

    // --- Vehicles ---
    match /vehicles/{vehicleId} {
      // Officers/Admins can read all, Citizens can only read their own
      allow read: if isAuth() && (hasRole('admin') || hasRole('officer') || resource.data.userId == request.auth.uid);
      allow create: if hasRole('admin') || hasRole('officer');
      allow update: if hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // --- Violations ---
    match /violations/{violationId} {
      allow read: if isAuth() && (hasRole('admin') || hasRole('officer') || resource.data.userId == request.auth.uid);
      allow create: if hasRole('admin') || hasRole('officer');
      // Vulnerability Note: Currently allowing citizens to update violations (e.g. isUnderReview or isPaid) because the client app logic requires it. 
      // This should be moved to Cloud Functions in a production environment.
      allow update: if isAuth() && (hasRole('admin') || hasRole('officer') || resource.data.userId == request.auth.uid);
      allow delete: if hasRole('admin');
    }

    // --- Objections (New Collection) ---
    match /objections/{objectionId} {
      allow read: if isAuth() && (hasRole('admin') || resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow update: if hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // --- Emergencies (New Collection) ---
    match /emergencies/{emergencyId} {
      allow read: if hasRole('admin') || hasRole('officer');
      allow create: if isAuth();
      allow update: if hasRole('admin') || hasRole('officer');
      allow delete: if hasRole('admin');
    }

    // --- Disputes (Legacy) ---
    match /disputes/{disputeId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if hasRole('admin') || hasRole('officer');
      allow delete: if hasRole('admin');
    }

    // --- Receipts ---
    match /receipts/{receiptId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || hasRole('admin') || hasRole('officer'));
      allow create: if isAuth();
      allow update, delete: if hasRole('admin');
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || hasRole('admin'));
      allow create: if isAuth();
      allow update, delete: if isAuth() && (resource.data.userId == request.auth.uid || hasRole('admin'));
    }

    // --- Logs & Announcements ---
    match /announcements_log/{logId} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    match /announcements/{announcementId} {
      allow read: if true; 
      allow create, update, delete: if hasRole('admin');
    }

    match /audit_logs/{logId} {
      allow read: if hasRole('admin');
      allow create: if isAuth();
      allow update, delete: if false; 
    }
  }
}
